# ============================================
# SAD OFFICINE — Configuration
# ============================================
# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env

# --- APPLICATION ---
APP_NAME=SAD Officine
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME_WITH_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# --- ENVOI D'EMAIL (mot de passe oublié) ---
# Laisser SMTP_HOST vide en dev : le code de réinitialisation est écrit dans les logs backend au lieu d'être envoyé.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@stockaid.app

# --- BASE DE DONNÉES ---
# Format: postgresql://user:password@host:port/dbname
# En local/desktop, sqlite:///./sad_officine.db fonctionne aussi (voir .env).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sad_officine

# --- CORS (Frontend React) ---
FRONTEND_URL=https://app.stockaid.example

# --- FICHIERS UPLOAD ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# --- CALCUL SAD (valeurs par défaut métier) ---
DEFAULT_ORDER_COST=2500
DEFAULT_HOLDING_RATE=0.20
DEFAULT_CYCLE_DAYS=10

# --- NIVEAUX DE SERVICE VED (facteurs Z par défaut) ---
Z_VITAL=2.326
Z_ESSENTIEL=1.645
Z_DESIRABLE=1.282
Z_NON_RENSEIGNE=1.645
